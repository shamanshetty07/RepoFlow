generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  repos     Repo[]
}

model Repo {
  id        Int      @id @default(autoincrement())
  githubUrl String
  status    Status   @default(PENDING)
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  chunks    Chunk[]
}

model Chunk {
  id         Int      @id @default(autoincrement())

  repoId     Int
  filePath   String
  language   String?
  content    String

  chunkIndex Int
  startIndex Int
  endIndex   Int
  startLine  Int
  endLine    Int
  tokenCount Int

  embedding  Float[]

  repo       Repo     @relation(fields: [repoId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([repoId, filePath, chunkIndex])
  @@index([repoId])
}

enum Status {
  PENDING
  CLONING
  READY
  FAILED
}