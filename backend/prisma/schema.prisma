

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
enum Status{
  PENDING
  CLONING
  READY 
  FAILED
}
model User{
  id Int   @id @default(autoincrement()) 
  name String
  email String @unique
  password String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  repos Repo[]
}

model Repo{
  id Int @id @default(autoincrement())
  githubUrl  String
  status Status @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId Int
  user User @relation(fields: [userId],references: [id])
  chunk Chunks[]
}

model Chunks{
    id Int @id @default(autoincrement())
    repositoryId Int
    language String
    content String[]
    chunkIndex Int
    startLine Int
    endLine Int
    tokenCount Int 
    embedding Int[]
    repoid Repo @relation(fields: [repositoryId],references: [id])

}


// Chunk
// ├── id
// ├── repositoryId
// ├── filePath
// ├── language
// ├── content        ← actual code/text
// ├── chunkIndex
// ├── startLine
// ├── endLine
// ├── tokenCount
// └── embedding      ← vector(768)